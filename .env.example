# =========================================================
# Economy and Fair Competition — variables de entorno
# Copiar a .env y completar valores reales. Nunca commitear .env.
# =========================================================

# --- Entorno ---
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- MongoDB ---
# Recomendado para desarrollo: un Mongo LOCAL separado del de producción
# (Atlas), para no arriesgar datos reales al editar/probar en dev — ver
# INFRA.md § "Bases de datos separadas dev/producción" para el cómo y el
# porqué. Con el contenedor mongo:7 local (ej. Docker, puerto expuesto a tu
# elección) autenticado con usuario/contraseña propios:
#   MONGODB_URI=mongodb://<usuario>:<password>@localhost:<puerto>/?authSource=admin
#   MONGODB_DB=economy-and-fair-competition-dev
# Alternativa (no recomendada salvo necesidad puntual de datos 100% reales):
# apuntar directo a Atlas con las credenciales reales del cluster.
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster-economy.mbwszze.mongodb.net/?retryWrites=true&w=majority&appName=cluster-economy
MONGODB_DB=economy-and-fair-competition-db

# --- Correo ---
# Desarrollo: Mailpit (contenedor compartido ya activo en el entorno local)
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
MAILPIT_UI_URL=http://localhost:8025
# Producción: Resend
RESEND_API_KEY=
MAIL_FROM="Economy and Fair Competition <no-reply@economyandfaircompetition.com>"
CONTACT_NOTIFICATION_EMAIL=contacto@economyandfaircompetition.com

# --- Autenticación (Magic Link admin) ---
JWT_SECRET=
MAGIC_LINK_CODE_TTL_MINUTES=10
MAGIC_LINK_MAX_ATTEMPTS=5
ADMIN_ALLOWED_EMAILS=admin@economyandfaircompetition.com
SESSION_COOKIE_NAME=efc_session

# --- i18n ---
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_LOCALES=es,en

# --- Logging (Pino) ---
PINO_LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# --- Almacenamiento ---
# Disco local (dev, y despliegues propios con filesystem persistente):
UPLOADS_DIR=./public/uploads
DOCUMENTS_DIR=./public/documents
MAX_UPLOAD_SIZE_MB=15
MAX_DOCUMENT_SIZE_MB=20
# Vercel Blob (producción en Vercel — el filesystem ahí es de solo lectura y
# no persiste entre deploys). Si esta variable está presente, lib/uploads.ts
# sube a Blob en vez de a disco local automáticamente; no requiere cambiar
# UPLOADS_DIR/DOCUMENTS_DIR. Se genera solo con `vercel blob create-store
# <nombre> --access public --yes` y Vercel la inyecta en producción; para
# desarrollo local con Blob, `vercel env pull` la trae a .env.local.
BLOB_READ_WRITE_TOKEN=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# --- MCP / WhatsApp ---
# El servidor MCP (/api/mcp) está implementado y se prueba vía HTTP directo
# (Postman/curl) con MCP_WEBHOOK_SECRET. La conexión con un proveedor real de
# WhatsApp (Meta Cloud API, Twilio, etc.) queda diferida — ver AGENTS.md §10.5.
# Generar MCP_WEBHOOK_SECRET con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_WEBHOOK_SECRET=
WHATSAPP_PROVIDER=
WHATSAPP_VERIFY_TOKEN=
# Teléfonos autorizados a ejecutar update_post/delete_post vía MCP (E.164, separados por coma)
MCP_ADMIN_PHONES=

# --- IA (Claude) — usada para: autodetección/conversión a Markdown de bloques
# de texto, y extracción de contenido desde PDF/URL al crear Artículos/Notas.
# Es solo el FALLBACK de arranque: el admin puede configurar su propia key
# desde /admin (Configuración > Integración IA), que se guarda cifrada en
# Mongo y toma prioridad sobre esta variable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_CONFIG_ENCRYPTION_KEY=

# --- Referencia futura (no activo en este MVP) ---
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root
VAULT_SECRET_PATH=economy-fair-competition
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_ACME_EMAIL=admin@economyandfaircompetition.com
ELASTICSEARCH_URL=http://localhost:9200
KIBANA_URL=http://localhost:5601
