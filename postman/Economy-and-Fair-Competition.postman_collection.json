            },
            "url": { "raw": "{{baseUrl}}/api/ai/markdown", "host": ["{{baseUrl}}"], "path": ["api", "ai", "markdown"] },
            "description": "Requiere sesión admin. Rate limit: 20/min por IP. Requiere ANTHROPIC_API_KEY configurada (vía panel admin o .env) para devolver 200; si no, responde 503 de forma controlada (circuit breaker / fallback documentado)."
          }
        },
        {
          "name": "Subir imagen (multipart)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Si no se seleccionó un archivo local en Postman (campo 'file' vacío por defecto",
                  "// en un JSON de colección, que no puede portar binarios), el servidor responde 400",
                  "// de forma correcta ('sin archivo'). Solo se valida 201 cuando sí hay archivo adjunto.",
                  "if (pm.response.code === 400) {",
                  "  pm.test('400 esperado sin archivo adjunto (seleccionar uno en la UI de Postman para probar 201)', function () {",
                  "    pm.expect(pm.response.code).to.eql(400);",
                  "  });",
                  "} else {",
                  "  pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "  pm.test('Devuelve url y la guarda en {{uploadedImageUrl}}', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.url).to.be.a('string');",
                  "    pm.environment.set('uploadedImageUrl', body.url);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/uploads", "host": ["{{baseUrl}}"], "path": ["api", "uploads"] },
            "description": "Requiere sesión admin. En el campo 'file' selecciona manualmente una imagen PNG/JPEG/WEBP/GIF desde el cliente de Postman (Postman no permite adjuntar binarios vía JSON de colección; el campo queda vacío hasta que se elige un archivo local en la UI)."
          }
        }
      ]
