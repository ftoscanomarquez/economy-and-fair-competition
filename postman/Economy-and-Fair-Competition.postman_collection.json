                "type": "text/javascript",
                "exec": [
                  "// 200 si hay ANTHROPIC_API_KEY configurada (admin o .env); 503 si no hay IA configurada.",
                  "pm.test('Status 200 o 503 (según configuración de IA)', function () {",
                  "  pm.expect([200, 503]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
